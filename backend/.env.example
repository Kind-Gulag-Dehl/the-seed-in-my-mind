# Copy to backend/.env and fill in values (do not commit secrets)
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Optional: point to a pgpass file for passwordless local auth
# PGPASSFILE=C:\path\to\pgpass.conf
# Optional: logging
RUST_LOG=info

# Required in production: HMAC key for auth session token hashing.
# Use at least 32 random bytes (base64/hex/string is fine).
# AUTH_SESSION_HMAC_KEY=

# Optional owner bootstrap (local-only; requires strong password)
# SEED_OWNER_BOOTSTRAP=1
# SEED_OWNER_USERNAME=
# SEED_OWNER_PASSWORD=
# SEED_OWNER_IDENTITY_ID=380b7817-db3b-7b76-8cf3-87df879ddddb

