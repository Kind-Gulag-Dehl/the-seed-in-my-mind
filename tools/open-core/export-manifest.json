{
  "version": 1,
  "export_root": "_export/open-core",
  "include_globs": [
    ".github/workflows/open-core-boundary.yml",
    "backend/**",
    "docs/authoritative-index.md",
    "docs/conformance/**",
    "docs/identity-admission-and-invitation-capacity-spec-v0.md",
    "docs/api-contract-read-only.md",
    "docs/canonical-encoding-and-hashing-spec.md",
    "docs/canonical-preservation-and-provenance-spine-spec.md",
    "docs/challenge-engine-spec.md",
    "docs/cross-doc-invariants.md",
    "docs/cycle-spec.md",
    "docs/deterministic-replay-and-merge-spec.md",
    "docs/governance-spec.md",
    "docs/ai-boundaries-spec.md",
    "docs/map.encoding-snapshots-bundles.md",
    "docs/map.index.md",
    "docs/conformance/canonical-event-signature-profile-v0.vectors.json",
    "docs/conformance/profile-v0-identity-admission.vectors.json",
    "docs/conformance/native-ordering.schema.json",
    "docs/conformance/native-ordering.vectors.json",
    "docs/conformance/seed-conformance-bindings.schema.json",
    "docs/conformance/seed-conformance-bindings.vectors.json",
    "docs/conformance/tempo-cycle-fixtures.schema.v1.json",
    "docs/conformance/tempo-cycle-fixtures.v1.json",
    "scripts/tempo-cycle-fixture-harness.mjs",
    "scripts/native-ordering-fixture-harness.mjs",
    "scripts/identity-source-integrity-harness.mjs",
    "scripts/seed-conformance-bindings-harness.mjs",
    "docs/map.node-and-replay.md",
    "docs/map.offline-and-preservation.md",
    "docs/map.protocol-v5.md",
    "docs/map.token-governance.md",
    "docs/node-and-conformance-spec.md",
    "docs/offline-and-mindseed-spec.md",
    "docs/open-core-architecture-overview.md",
    "docs/open-core-boundary-manifest.md",
    "docs/open-core-demo-flow.md",
    "docs/open-core-implementation-status.md",
    "docs/open-core-reviewer-guide.md",
    "docs/open-core-split-and-data-boundary-spec.md",
    "docs/pod-consensus-and-canonical-publication-spec.md",
    "docs/privacy-and-high-risk-submission-spec.md",
    "docs/protocol v5-appendix-a.md",
    "docs/protocol v5.md",
    "docs/roles-and-stewardship-spec.md",
    "docs/safety-rulebook-interface-mechanics-spec.md",
    "docs/safety-spec.md",
    "docs/shared-map-and-payload-bundles-spec.md",
    "docs/snapshot-format-v0.md",
    "docs/stage0-runtime-configuration.md",
    "docs/tempo-spec.md",
    "docs/token-spec.md",
    "docs/tribe-spec.md",
    "docs/verification-spec.md",
    "frontend/open-core-reference/**",
    "frontend/src/shared/types/canonical.ts",
    "package.json",
    "package-lock.json",
    "scripts/check-open-core-boundaries.mjs",
    "scripts/grant-reviewer-quickstart.ps1",
    "scripts/open-core-demo.ps1",
    "scripts/verify-seed-conformance-bindings-postgres.ps1",
    "scripts/verify-open-core-export.mjs",
    "tools/open-core/**",
    "seed/**",
    "LICENSE",
    "NOTICE",
    "TRADEMARKS.md",
    ".gitignore",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "exclude_globs": [
    "**/.git/**",
    "**/.github/cache/**",
    "**/.env",
    "**/.env.local",
    "**/.env.development",
    "**/.env.production",
    "**/.env.test",
    "**/.env.*.local",
    "**/.vite/**",
    "**/*.cache",
    "**/*.db",
    "**/*.log",
    "**/*.sqlite",
    "**/*.sqlite3",
    "**/*.tmp",
    "**/*.tsbuildinfo",
    "**/coverage/**",
    "**/dist/**",
    "**/node_modules/**",
    "backend/target/**",
    "backend/target-codex/**",
    "backend/crates/api-types-private/**",
    "backend/var/**",
    "docs/archive/**",
    "docs/audit/**",
    "docs/codex-devlog.md",
    "docs/codex-notes.md",
    "docs/planning/**",
    "_export/**"
  ],
  "required_absent_paths": [
    "backend/.env",
    "backend/crates/api-types-private",
    "backend/var",
    "docs/archive",
    "docs/audit",
    "docs/codex-devlog.md",
    "docs/codex-notes.md",
    "docs/planning",
    "frontend/open-core-reference/dist",
    "frontend/open-core-reference/node_modules",
    "frontend/open-core-reference/package-lock.json",
    "frontend/open-core-reference/tsconfig.tsbuildinfo",
    "tools/open-core/dist"
  ],
  "forbidden_path_globs": [
    "**/.env",
    "**/.env.local",
    "**/.env.development",
    "**/.env.production",
    "**/.env.test",
    "**/.env.*.local",
    "**/.vite/**",
    "**/*.cache",
    "**/*.db",
    "**/*.log",
    "**/*.sqlite",
    "**/*.sqlite3",
    "**/*.tmp",
    "**/*.tsbuildinfo",
    "**/coverage/**",
    "**/dist/**",
    "**/node_modules/**",
    "_target/**",
    "backend/target/**",
    "backend/target-codex/**",
    "backend/var/**",
    "docs/archive/**",
    "docs/audit/**",
    "docs/planning/**",
    "docs/codex-devlog.md",
    "docs/codex-notes.md",
    "frontend/open-core-reference/package-lock.json",
    "tools/open-core/dist/**"
  ],
  "must_not_appear": [
    {
      "glob": "frontend/open-core-reference/src/**/*.{ts,tsx,js,jsx}",
      "pattern": "domains/private|domains/private-overlay|api/private|app/workspaceshell|app/tabstate|builderview",
      "description": "reference frontend must not import proprietary/private/product modules"
    },
    {
      "glob": "backend/crates/**/*.{rs,toml}",
      "pattern": "api_types_private|api-types-private",
      "description": "open-core backend crates should not reference private DTO crate (except the private crate itself)",
      "exclude_globs": [
        "backend/crates/api-types-private/**"
      ]
    }
  ],
  "required_root_files": [
    "LICENSE",
    "NOTICE",
    "TRADEMARKS.md",
    ".gitignore",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "backend/.env.example",
    "package.json",
    "package-lock.json",
    "docs/open-core-architecture-overview.md",
    "docs/open-core-demo-flow.md",
    "docs/open-core-implementation-status.md",
    "docs/open-core-reviewer-guide.md",
    "docs/authoritative-index.md",
    "docs/identity-admission-and-invitation-capacity-spec-v0.md",
    "docs/map.index.md",
    "docs/conformance/canonical-event-signature-profile-v0.vectors.json",
    "docs/conformance/profile-v0-identity-admission.vectors.json",
    "docs/conformance/native-ordering.schema.json",
    "docs/conformance/native-ordering.vectors.json",
    "docs/conformance/seed-conformance-bindings.schema.json",
    "docs/conformance/seed-conformance-bindings.vectors.json",
    "docs/conformance/tempo-cycle-fixtures.schema.v1.json",
    "docs/conformance/tempo-cycle-fixtures.v1.json",
    "scripts/tempo-cycle-fixture-harness.mjs",
    "scripts/native-ordering-fixture-harness.mjs",
    "scripts/identity-source-integrity-harness.mjs",
    "scripts/seed-conformance-bindings-harness.mjs",
    "scripts/grant-reviewer-quickstart.ps1",
    "scripts/check-open-core-boundaries.mjs",
    "scripts/verify-seed-conformance-bindings-postgres.ps1",
    "scripts/open-core-demo.ps1",
    "scripts/verify-open-core-export.mjs",
    "tools/open-core/verify-canonical-dto.mjs",
    "tools/open-core/canonical-dto-surface.json",
    "tools/open-core/smoke-export.ps1"
  ],
  "verification_commands": [
    [
      "npm",
      "run",
      "conformance"
    ],
    [
      "node",
      "scripts/identity-source-integrity-harness.mjs"
    ],
    [
      "node",
      "tools/open-core/verify-canonical-dto.mjs"
    ],
    [
      "node",
      "scripts/verify-open-core-export.mjs",
      "--export-root",
      "{export_root}"
    ]
  ],
  "required_npm_projects": [
    {
      "path": "frontend/open-core-reference",
      "required_scripts": [
        "dev",
        "lint:boundaries",
        "test",
        "build"
      ],
      "commands": [
        [
          "npm",
          "install"
        ],
        [
          "npm",
          "run",
          "lint:boundaries"
        ],
        [
          "npm",
          "test"
        ],
        [
          "npm",
          "run",
          "build"
        ]
      ]
    }
  ],
  "required_rust_workspaces": [
    {
      "path": "backend",
      "required_workspace_members": [
        "crates/common",
        "crates/encoding",
        "crates/event-log",
        "crates/replay",
        "crates/snapshot",
        "crates/storage",
        "crates/api-types-canonical",
        "bins/api-server",
        "bins/snapshot-builder",
        "bins/snapshot-verify",
        "bins/seed-importer"
      ],
      "commands": [
        [
          "cargo",
          "build"
        ],
        [
          "cargo",
          "test"
        ]
      ]
    }
  ],
  "boundary_check_command": [
    "node",
    "scripts/check-open-core-boundaries.mjs",
    "scripts/tempo-cycle-fixture-harness.mjs",
    "scripts/native-ordering-fixture-harness.mjs",
    "scripts/identity-source-integrity-harness.mjs",
    "scripts/seed-conformance-bindings-harness.mjs",
    "--frontend-dir",
    "frontend/open-core-reference"
  ]
}
