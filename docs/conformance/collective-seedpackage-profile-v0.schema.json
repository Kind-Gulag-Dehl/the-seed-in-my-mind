{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seed.conformance.collective_seedpackage_profile.v0",
  "title": "Collective SeedPackage Profile v0 conformance vectors",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "spec_version",
    "hash_algorithm",
    "closed_profile_ids",
    "canonical_vectors",
    "behavior_vectors"
  ],
  "properties": {
    "schema": {
      "const": "seed.conformance.collective_seedpackage_profile.v0"
    },
    "spec_version": {
      "const": 0
    },
    "hash_algorithm": {
      "const": "blake3-256"
    },
    "closed_profile_ids": {
      "const": [
        "pocket_map_v0",
        "citizen_map_v0",
        "civic_archive_v0",
        "full_archive_v0",
        "playable_offline_v1",
        "full_recovery_v0",
        "archive_shard_set_v0"
      ]
    },
    "canonical_vectors": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/canonicalVector"
      }
    },
    "behavior_vectors": {
      "type": "array",
      "minItems": 20,
      "items": {
        "$ref": "#/$defs/behaviorVector"
      }
    }
  },
  "$defs": {
    "lowerHex": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})*$"
    },
    "hash32Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canonicalVector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "artifact_kind",
        "domain_tag_ascii",
        "canonical_bytes_hex",
        "expected_blake3_256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "artifact_kind": {
          "enum": [
            "artifact",
            "seedpackage_manifest",
            "archive_shard",
            "archive_shard_manifest",
            "catastrophe_successor_declaration"
          ]
        },
        "domain_tag_ascii": {
          "enum": [
            "seedpackage_artifact_v0",
            "seedpackage_manifest_v0",
            "archive_shard_v0",
            "archive_shard_manifest_v0",
            "catastrophe_successor_declaration_v0"
          ]
        },
        "canonical_bytes_hex": {
          "$ref": "#/$defs/lowerHex"
        },
        "expected_blake3_256": {
          "$ref": "#/$defs/hash32Hex"
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "behaviorVector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "expected",
        "input",
        "assertions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "kind": {
          "enum": [
            "profile",
            "selection",
            "container",
            "commitment",
            "history",
            "lineage",
            "shards",
            "custody"
          ]
        },
        "expected": {
          "enum": [
            "accept",
            "reject"
          ]
        },
        "expected_error": {
          "type": "string",
          "pattern": "^ERR_[A-Z0-9_]+$"
        },
        "input": {
          "type": "object"
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "expected": {
                "const": "reject"
              }
            }
          },
          "then": {
            "required": [
              "expected_error"
            ]
          }
        }
      ]
    }
  }
}
