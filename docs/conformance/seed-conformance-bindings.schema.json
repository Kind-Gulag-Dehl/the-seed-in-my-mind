{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seed.conformance.seed_conformance_bindings.v1",
  "title": "Seed representation conformance-binding vectors",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "identity_positions",
    "idea_positions",
    "vectors",
    "hash_vectors"
  ],
  "properties": {
    "schema": {
      "const": "seed.conformance.seed_conformance_bindings.v1"
    },
    "identity_positions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/position"
      }
    },
    "idea_positions": {
      "type": "object",
      "additionalProperties": {
        "allOf": [
          {
            "$ref": "#/$defs/position"
          },
          {
            "type": "object",
            "required": [
              "idea_type"
            ],
            "properties": {
              "idea_type": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "vectors": {
      "type": "array",
      "minItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "events",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SCB-[0-9]{3}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/event"
            }
          },
          "expected": {
            "$ref": "#/$defs/expected"
          }
        }
      }
    },
    "hash_vectors": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "payload",
          "canonical_json_utf8",
          "blake3"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          },
          "canonical_json_utf8": {
            "type": "string"
          },
          "blake3": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "required": [
        "block_height",
        "event_index"
      ],
      "properties": {
        "block_height": {
          "type": "integer",
          "minimum": 0
        },
        "event_index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "speaker_identity_id",
        "block_height",
        "event_index",
        "payload"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "const": "representation_create"
        },
        "speaker_identity_id": {
          "type": "string"
        },
        "block_height": {
          "type": "integer",
          "minimum": 0
        },
        "event_index": {
          "type": "integer",
          "minimum": 0
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accept",
        "code"
      ],
      "properties": {
        "accept": {
          "type": "boolean"
        },
        "code": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
